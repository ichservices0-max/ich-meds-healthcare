generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  phone          String          @unique
  passwordHash   String
  dateOfBirth    String?
  bloodGroup     String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  records        MedicalRecord[]
  notifications  Notification[]
  passwordResets PasswordReset[]
  prescriptions  Prescription[]
  reviews        Review[]

  @@map("patients")
}

model Doctor {
  id                 String                @id @default(uuid())
  name               String
  email              String                @unique
  phone              String                @unique
  passwordHash       String
  registrationNumber String                @unique
  qualification      String
  degree             String
  experience         Int
  specialty          String
  clinicName         String?
  clinicAddress      String
  city               String
  state              String
  country            String
  lat                Float
  lng                Float
  rating             Float                 @default(0)
  reviewCount        Int                   @default(0)
  fee                Float
  bio                String?
  imageUrl           String?
  documents          Json?
  languagesSpoken    String[]              @default([])
  verificationStatus String                @default("PENDING")
  isOnline           Boolean               @default(false)
  membershipStatus   String                @default("INACTIVE")
  membershipPaidAt   DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  appointments       Appointment[]
  passwordResets     DoctorPasswordReset[]
  sessions           DoctorSession[]
  notifications      Notification[]
  prescriptions      Prescription[]
  reviews            Review[]

  @@map("doctors")
}

model DoctorSession {
  id           String        @id @default(uuid())
  doctorId     String
  date         DateTime
  sessionType  String
  startTime    String
  endTime      String
  maxTokens    Int
  currentToken Int           @default(0)
  appointments Appointment[]
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date, sessionType])
  @@map("doctor_sessions")
}

model Appointment {
  id            String        @id @default(uuid())
  doctorId      String
  patientId     String
  sessionId     String
  status        String        @default("PENDING")
  paymentStatus String        @default("UNPAID")
  fee           Float?
  scheduledAt   DateTime?
  notes         String?
  type          String?  @default("in-person")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tokenNumber   Int           @default(0)
  doctor        Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  session       DoctorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages      Message[]
  payments      Payment[]
  preCheck      PreCheck?
  prescriptions Prescription?

  @@map("appointments")
}

model Payment {
  txnid         String       @id
  appointmentId String?
  amount        Float
  currency      String       @default("INR")
  status        String       @default("INITIATED")
  mode          String       @default("PAYU")
  payuRequest   Json?
  payuResponse  Json?
  mihpayid      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("payments")
}

model PreCheck {
  id             String      @id @default(uuid())
  appointmentId  String      @unique
  symptoms       String?
  vitalSigns     Json?
  medicalHistory String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("pre_checks")
}

model Message {
  id            String      @id @default(uuid())
  appointmentId String
  senderId      String
  senderRole    String
  content       String?
  fileUrl       String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model MedicalRecord {
  id        String   @id @default(uuid())
  patientId String
  type      String
  fileName  String
  fileUrl   String
  fileSize  Int
  notes     String?
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_records")
}

model Review {
  id         String   @id @default(uuid())
  doctorId   String
  patientId  String
  rating     Int
  reviewText String
  createdAt  DateTime @default(now())
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  patientId String?
  doctorId  String?
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  doctor    Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PasswordReset {
  id        String    @id @default(uuid())
  patientId String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model DoctorPasswordReset {
  id        String    @id @default(uuid())
  doctorId  String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_password_resets")
}

model Prescription {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  doctorId      String
  patientId     String
  imageUrl      String?
  digitalText   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("admins")
}
